            "example": {
                "title": "Accessible Form",
                "code": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Accessibility Example</title>\n</head>\n<body>\n  <form>\n    <label for=\"name\">Nama</label>\n    <input id=\"name\" type=\"text\" aria-label=\"Input Nama\">\n\n    <img src=\"logo.png\" alt=\"Logo Website Sekolah\">\n\n    <button type=\"submit\">Kirim</button>\n  </form>\n</body>\n</html>"
