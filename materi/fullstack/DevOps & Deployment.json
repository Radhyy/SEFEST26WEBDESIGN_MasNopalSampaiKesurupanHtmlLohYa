  "Docker": {
    "description": "Docker digunakan untuk menjalankan aplikasi dalam container agar environment tetap konsisten di development maupun production.",

    "features": [
      "Containerization",
      "Portable environments",
      "Environment consistency",
      "Fast deployment",
      "Microservices support"
    ],

    "advantages": [
      "Mengurangi environment mismatch",
      "Deployment lebih stabil",
      "Mudah dipindahkan antar server",
      "Cocok untuk CI/CD workflow"
    ],

    "examples": [
      "Containerized Node.js API",
      "Dockerized PostgreSQL database",
      "Multi-container application"
    ],

    "example": {
      "title": "Docker Run Example",
      "code": "docker run -p 3000:3000 my-app"
    },

    "Dockerfile_example": {
      "title": "Simple Dockerfile",
      "code": "FROM node:20\nWORKDIR /app\nCOPY . .\nRUN npm install\nCMD [\"npm\", \"start\"]"
    },

    "docker_compose_example": {
      "title": "Docker Compose Example",
      "code": "services:\n  app:\n    build: .\n    ports:\n      - '3000:3000'"
    }
  },

