{
  "Semantic_HTML": {
    "description": "Semantic HTML adalah penggunaan elemen HTML berdasarkan makna dan struktur kontennya agar lebih mudah dipahami oleh browser, search engine, dan assistive technology.",

    "semantic_elements": [
      "<header>",
      "<nav>",
      "<main>",
      "<section>",
      "<article>",
      "<footer>",
      "<aside>"
    ],

    "benefits": [
      "SEO lebih baik",
      "Accessibility meningkat",
      "Kode lebih mudah dipahami",
      "Struktur dokumen lebih jelas",
      "Membantu screen readers"
    ],

    "examples": [
      "Blog layout",
      "News article structure",
      "Accessible navigation",
      "Semantic landing page"
    ],

    "code_example": {
      "title": "Semantic Layout Example",
      "code": "<main><section><article><h1>Title</h1></article></section></main>"
    },

    "real_world_use_cases": [
      "SEO-friendly websites",
      "Accessible government websites",
      "Content-heavy platforms"
    ]
  },

  "Flexbox_and_Grid": {
    "description": "Flexbox dan CSS Grid adalah sistem layout modern dalam CSS yang digunakan untuk mengatur posisi dan ukuran elemen dengan lebih fleksibel dan responsif.",

    "Flexbox": {
      "description": "Flexbox digunakan untuk layout satu dimensi (horizontal atau vertical).",

      "features": [
        "Flexible alignment",
        "Space distribution",
        "Responsive arrangement",
        "Easy centering"
      ],

      "examples": [
        "Navbar layout",
        "Centering elements",
        "Horizontal card layout"
      ],

      "code_example": {
        "title": "Flexbox Example",
        "code": ".container { display:flex; justify-content:center; align-items:center; }"
      }
    },

    "CSS_Grid": {
      "description": "CSS Grid digunakan untuk layout dua dimensi (baris dan kolom).",

      "features": [
        "Grid template system",
        "Complex layouts",
        "Row & column control",
        "Responsive grid design"
      ],

      "examples": [
        "Dashboard layout",
        "Gallery grid",
        "Responsive product cards"
      ],

      "code_example": {
        "title": "Grid Example",
        "code": ".grid { display:grid; grid-template-columns: repeat(3, 1fr); gap:20px; }"
      }
    },

    "real_world_use_cases": [
      "Admin dashboard UI",
      "Responsive website layouts",
      "Modern SaaS interface"
    ]
  },

