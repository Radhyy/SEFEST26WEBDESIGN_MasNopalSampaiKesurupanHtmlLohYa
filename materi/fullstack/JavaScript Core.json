{
  "JavaScript_Core": {
    "description": "JavaScript Core adalah dasar utama bahasa pemrograman JavaScript yang digunakan untuk membuat website menjadi interaktif dan dinamis. JavaScript berjalan di browser maupun server (Node.js) dan menjadi fondasi utama frontend modern.",

    "main_topics": [
