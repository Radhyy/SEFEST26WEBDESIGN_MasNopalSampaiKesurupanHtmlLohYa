      "Dynamic dashboards",
      "Frontend web applications"
    ]
  },

  "DOM_Manipulation": {
    "description": "DOM Manipulation adalah proses mengakses dan mengubah elemen HTML menggunakan JavaScript melalui Document Object Model (DOM).",

    "main_goals": [
      "Mengubah konten halaman secara dinamis",
      "Menambahkan atau menghapus elemen",
      "Mengontrol interaksi user",
      "Membuat UI lebih interaktif"
    ],

    "common_methods": [
      "document.querySelector()",
      "document.getElementById()",
      "element.innerHTML",
      "element.classList",
      "addEventListener()"
    ],

    "examples": [
      "Dark mode toggle",
      "Dynamic navbar",
      "Interactive forms",
      "Popup modal"
    ],

    "example": {
      "title": "DOM Manipulation Example",
      "code": "document.querySelector('button').addEventListener('click', () => {\n  document.body.style.background = 'black';\n});"
    },

    "real_world_use_cases": [
      "Interactive portfolio websites",
      "Real-time UI updates",
      "Animated web components",
      "Dynamic product pages"
    ]
  },

  "Async_Await_and_Fetch": {
    "description": "Async/Await dan Fetch digunakan untuk menangani asynchronous programming di JavaScript, terutama saat mengambil data dari API atau server.",

    "Async_Await": {
      "description": "Async/Await membuat asynchronous code terlihat seperti synchronous sehingga lebih mudah dibaca dan dikelola.",

      "benefits": [
        "Code lebih clean",
        "Error handling lebih mudah",
        "Readable asynchronous flow"
      ],

      "examples": [
        "Fetching API data",
        "Login authentication",
        "Loading user profile"
      ]
    },

    "Fetch_API": {
      "description": "Fetch API digunakan untuk melakukan HTTP request ke server atau API.",

      "methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],

      "examples": [
        "Mengambil data dari REST API",
        "Mengirim form data",
        "Update database melalui API"
      ]
    },

    "example": {
      "title": "Fetch Example",
      "code": "async function getData() {\n  const response = await fetch('/api/data');\n  const data = await response.json();\n  console.log(data);\n}"
    },

