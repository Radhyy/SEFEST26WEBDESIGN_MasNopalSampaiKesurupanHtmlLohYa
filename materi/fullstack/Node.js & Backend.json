    "main_goals": [
      "Membangun backend server menggunakan JavaScript",
      "Membuat REST API",
      "Menangani request dan response",
      "Mengelola komunikasi client-server",
      "Membangun aplikasi real-time"
    ],

    "core_concepts": [
      "Event-driven architecture",
      "Non-blocking I/O",
      "Asynchronous programming",
      "Single-threaded runtime"
    ],

    "common_use_cases": [
      "REST APIs",
      "Realtime chat apps",
      "Authentication systems",
      "Backend services"
    ],

    "examples": [
      "Realtime chat application",
      "Authentication backend",
      "File upload server",
      "Realtime notification system"
    ],

    "code_example": {
      "title": "Basic Node.js Server Example",
      "code": "const http = require('http');\nhttp.createServer((req, res) => {\n  res.end('Hello Node.js');\n}).listen(3000);"
    },

    "real_world_use_cases": [
      "Social media backend",
      "Streaming services",
      "Realtime collaboration apps",
      "RESTful backend APIs"
